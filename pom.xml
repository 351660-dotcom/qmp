<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.qmp</groupId>
  <artifactId>scenic-saas-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>景区文旅 SaaS 平台 · 门票全链路</name>
  <description>
    门票全链路模块化单体脚手架（ADR-010）。各服务为独立 Maven 模块 + 独立可运行的 Spring Boot 应用，
    通过 REST + RocketMQ 交互，对应 docs/09-门票全链路服务契约.md 的 OpenAPI/事件契约。
  </description>

  <modules>
    <module>inventory-kernel</module>
    <module>product-service</module>
    <module>pricing-service</module>
    <module>member-service</module>
    <module>inventory-service</module>
    <module>payment-service</module>
    <module>ticket-verification-service</module>
    <module>order-service</module>
    <module>hotel-pms-service</module>
    <module>marketing-service</module>
    <module>integration-tests</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>3.3.5</spring-boot.version>
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
    <rocketmq-spring.version>2.3.1</rocketmq-spring.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Spring Boot BOM：统一管理 Spring Boot 全家桶版本 -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.rocketmq</groupId>
        <artifactId>rocketmq-spring-boot-starter</artifactId>
        <version>${rocketmq-spring.version}</version>
      </dependency>

      <!-- 内部共享模块：ApiResponse/EventEnvelope/TenantContext/库存预占设计模式（ADR-025） -->
      <dependency>
        <groupId>com.qmp</groupId>
        <artifactId>inventory-kernel</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${java.version}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <!-- 固定 surefire 3.x，保证 JUnit 5 测试（含黄金路径集成测试）可被执行 -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
