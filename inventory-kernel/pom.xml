<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.qmp</groupId>
    <artifactId>scenic-saas-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>inventory-kernel</artifactId>
  <packaging>jar</packaging>
  <name>inventory-kernel</name>
  <description>
    门票全链路共享内核：统一响应格式/错误码（09 文档 1.1）、MQ 事件 Envelope（09 文档 1.3）、
    多租户上下文与 MyBatis-Plus 租户拦截器（10 文档通用约定）、
    「日期/场次型」库存桶与预占设计模式的参考实现基类（ADR-025）。
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- 健康检查/运维端点：依赖内核的服务自动获得 /actuator/health（k8s 探针 / compose healthcheck / 监控用） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
